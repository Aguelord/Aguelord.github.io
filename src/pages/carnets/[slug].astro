---
import Layout from '../../layouts/Layout.astro';
import { carnets } from '../../lib/carnets';
import { href, date } from '../../lib/projects';
import essay from '../../data/textes/abstraction-classification.html?raw';
export function getStaticPaths() { return carnets.map(carnet=>({params:{slug:carnet.slug},props:{carnet}})); }
const {carnet} = Astro.props;
const {Content} = carnet;
const fullText = carnet.fullText === 'abstraction-classification' ? essay.replaceAll('src="public/', `src="${href()}`).replace('A close-up of a color chart AI-generated content may be incorrect.', 'Schéma de superposition des couleurs rouge, vert et bleu.') : null;
---
<Layout title={`${carnet.title} — Carnets`} description={carnet.excerpt}>
<article class="reading"><a class="back" href={href('carnets/')}>← Tous les carnets</a><p class="eyebrow">{carnet.category} · {carnet.format} · {carnet.status}</p><h1>{carnet.title}</h1><p class="intro">{carnet.excerpt}</p><p class="authorship">{carnet.author}{carnet.author && ' · '}{carnet.dateLabel || date(carnet.date)}</p>{carnet.ai && <p class="ai-disclosure"><strong>Contribution de l’IA au texte original :</strong> {carnet.ai}</p>}<div class="prose"><Content/>{fullText && <div set:html={fullText}/>}</div>
{carnet.document && <section class="source-document" aria-label="Document original"><a class="button" href={href(carnet.document)} target="_blank" rel="noopener">{carnet.documentType === 'PDF' ? 'Ouvrir le PDF original ↗' : 'Télécharger le document Word ↓'}</a>{carnet.documentType === 'PDF' && <details><summary>Lire le PDF dans cette page</summary><object data={href(carnet.document)} type="application/pdf" aria-label={`Document original : ${carnet.title}`}><p>Votre navigateur ne propose pas de lecteur PDF intégré. <a href={href(carnet.document)}>Ouvrir le document</a>.</p></object></details>}</section>}
{carnet.ai && <p class="integration-note">La mention ci-dessus concerne la création du texte. Sa fiche de présentation et sa mise en ligne dans l’atelier ont été préparées avec une IA générative ; le contenu du document original est conservé.</p>}
{carnet.publication && <p class="publication"><a href={carnet.publication}>Lire la publication en revue ↗</a></p>}</article>
</Layout>
<style>
.authorship,.ai-disclosure,.integration-note{font-size:13px;line-height:1.8;color:#596358}.ai-disclosure{border-left:2px solid var(--accent);padding-left:16px}.integration-note{margin-top:32px;font-size:12px}.source-document{margin-top:30px}.source-document details{margin-top:25px}.source-document summary{cursor:pointer;font-size:14px;padding:15px 0}.source-document object{display:block;width:100%;height:75vh;min-height:400px;border:1px solid var(--line)}.prose :global(math[display=block]){display:block;overflow-x:auto;max-width:100%;padding:12px 0}.prose :global(img){object-fit:contain;height:auto!important}
.reading{max-width:760px;margin:auto;padding:45px 0 80px}.reading h1{font-family:Georgia,serif;font-size:clamp(36px,5vw,58px);line-height:1.15;letter-spacing:-1.5px;overflow-wrap:anywhere}.reading time{font:12px Consolas,monospace;color:#647160}.prose{font-family:Georgia,serif;font-size:19px;line-height:1.85;margin-top:45px;overflow-wrap:anywhere}.prose :global(h2),.prose :global(h3){line-height:1.3;margin:1.8em 0 .6em}.prose :global(a){text-decoration:underline;color:var(--accent)}.prose :global(blockquote){margin:25px 0;padding-left:24px;border-left:2px solid var(--accent);font-style:italic}.prose :global(img){max-width:100%;height:auto}.prose :global(pre){overflow:auto;padding:20px;background:#eaece0;font-size:14px}.prose :global(table){display:block;overflow:auto;border-collapse:collapse;font-size:16px}.prose :global(td),.prose :global(th){padding:8px;border:1px solid var(--line)}.prose :global(.footnotes){font-size:14px;border-top:1px solid var(--line);margin-top:40px}.publication{padding-top:25px;border-top:1px solid var(--line)}
</style>
